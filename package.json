{
  "name": "privernal-platform-ui",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "春祈平台（Privernal Studio）前端 / Privernal Studio low-code platform console, built with Vue3, Vite, TypeScript, Element Plus and UnoCSS.",
  "author": {
    "name": "saperliu",
    "url": "https://github.com/saperliu"
  },
  "license": "MIT",
  "homepage": "https://github.com/saperliu/privernal-platform-ui",
  "repository": {
    "url": "https://github.com/saperliu/privernal-platform-ui.git"
  },
  "bugs": {
    "url": "https://github.com/saperliu/privernal-platform-ui/issues"
  },
  "keywords": ["Vue3", "Vite", "TypeScript", "Element Plus", "UnoCSS", "low-code", "admin console"],
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=8.7.0"
  },
  "scripts": {
    "build": "vite build --mode prod",
    "build:test": "vite build --mode test",
    "cleanup": "privernal cleanup",
    "commit": "privernal git-commit",
    "commit:zh": "privernal git-commit -l=zh-cn",
    "dev": "vite --mode test",
    "dev:prod": "vite --mode prod",
    "gen-route": "privernal gen-route",
    "licenses:dump": "node scripts/dump-prod-licenses.mjs",
    "lint": "eslint . --fix",
    "lint:datav": "node scripts/check-datav-tokens.mjs && node scripts/check-datav-config.mjs",
    "prepare": "simple-git-hooks",
    "preview": "vite preview",
    "release": "privernal release",
    "test:datav": "node scripts/test-datav-utils.mjs",
    "test:sheet-print": "tsx scripts/test-sheet-print.ts",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "update-pkg": "privernal update-pkg"
  },
  "dependencies": {
    "@antv/data-set": "0.11.8",
    "@antv/g2": "5.4.8",
    "@antv/g6": "5.1.0",
    "@better-scroll/core": "2.5.1",
    "@iconify/vue": "5.0.0",
    "@logicflow/core": "^2.1.11",
    "@logicflow/extension": "^2.1.15",
    "@privernal/alova": "workspace:*",
    "@privernal/axios": "workspace:*",
    "@privernal/color": "workspace:*",
    "@privernal/hooks": "workspace:*",
    "@privernal/materials": "workspace:*",
    "@privernal/utils": "workspace:*",
    "@vicons/antd": "^0.12.0",
    "@vicons/carbon": "0.12.0",
    "@vicons/ionicons5": "^0.12.0",
    "@vicons/material": "0.12.0",
    "@visactor/vchart": "2.0.20",
    "@visactor/vchart-theme": "1.12.3",
    "@visactor/vtable-editors": "1.25.0",
    "@visactor/vtable-gantt": "1.25.0",
    "@visactor/vue-vtable": "1.25.0",
    "@vueuse/components": "14.2.1",
    "@vueuse/core": "14.2.1",
    "@wangeditor/core": "1.1.19",
    "@wangeditor/editor": "5.1.23",
    "@wangeditor/editor-for-vue": "5.1.12",
    "clipboard": "2.0.11",
    "dayjs": "1.11.20",
    "defu": "^6.1.4",
    "dingtalk-jsapi": "^3.0.12",
    "dompurify": "3.3.3",
    "echarts": "6.0.0",
    "element-plus": "^2.13.6",
    "jquery-mousewheel": "3.1.13",
    "jsbarcode": "3.12.3",
    "json5": "2.2.3",
    "luckysheet": "2.1.13",
    "moment": "^2.30.1",
    "monaco-editor": "^0.56.0",
    "nprogress": "0.2.0",
    "phoenix-designer": "^1.3.14",
    "pinia": "3.0.4",
    "pinyin-pro": "3.28.0",
    "print-js": "1.6.0",
    "qrcode": "1.5.4",
    "seemly": "^0.3.10",
    "socket.io-client": "4.7.4",
    "swiper": "12.1.3",
    "tailwind-merge": "3.5.0",
    "ua-parser-js": "1.0.36",
    "vditor": "3.11.2",
    "vue": "3.5.31",
    "vue-draggable-plus": "0.6.1",
    "vue-i18n": "11.3.0",
    "vue-pdf-embed": "2.1.4",
    "vue-router": "5.0.4",
    "vuedraggable": "4.1.0",
    "wangeditor": "4.7.15",
    "xgplayer": "3.0.24",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@amap/amap-jsapi-types": "0.0.15",
    "@elegant-router/vue": "0.3.8",
    "@iconify/json": "2.2.458",
    "@privernal/scripts": "workspace:*",
    "@privernal/uno-preset": "workspace:*",
    "@soybeanjs/eslint-config": "1.7.5",
    "@types/bmapgl": "0.0.7",
    "@types/node": "25.5.0",
    "@types/nprogress": "0.2.3",
    "@unocss/eslint-config": "66.6.7",
    "@unocss/preset-icons": "66.6.7",
    "@unocss/preset-uno": "66.6.7",
    "@unocss/transformer-directives": "66.6.7",
    "@unocss/transformer-variant-group": "66.6.7",
    "@unocss/vite": "66.6.7",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitejs/plugin-vue-jsx": "5.1.5",
    "consola": "3.4.2",
    "eslint": "9.39.2",
    "eslint-plugin-vue": "10.6.2",
    "kolorist": "1.8.0",
    "sass": "1.98.0",
    "simple-git-hooks": "2.13.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "unplugin-auto-import": "21.0.0",
    "unplugin-icons": "23.0.1",
    "unplugin-vue-components": "32.0.0",
    "vite": "npm:rolldown-vite@7.3.1",
    "vite-plugin-progress": "0.0.7",
    "vite-plugin-svg-icons": "2.0.1",
    "vite-plugin-vue-devtools": "8.1.1",
    "vue-eslint-parser": "10.4.0",
    "vue-tsc": "3.2.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@logicflow/core", "monaco-editor", "es5-ext", "vue-demi"]
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm privernal git-commit-verify",
    "pre-commit": "pnpm typecheck && pnpm lint && git diff --exit-code"
  }
}
